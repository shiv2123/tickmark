# Copy to .env and fill in. .env is gitignored.

# Fine-grained PAT, read-only. Used by the local CLI and the corpus miner.
# In GitHub Actions the action uses GITHUB_TOKEN instead and this is unset.
GITHUB_TOKEN=

# Judgment layer. Not needed until Stage 3.
# Any OpenAI-compatible endpoint works.
TICKMARK_MODEL_BASE_URL=http://localhost:11434/v1
TICKMARK_MODEL_NAME=qwen3:8b
TICKMARK_MODEL_API_KEY=ollama
